# Salin ke .env.local untuk local development
# cp .env.example .env.local
#
# Untuk production, set di Vercel Dashboard:
# Settings → Environment Variables → Add GFW_API_TOKEN

# Global Fishing Watch API token (nama sesuai laporan audit B.17; nama lama GFW_TOKEN masih dibaca)
# Dapatkan di: https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=your_gfw_token_here

# AISStream API key untuk relay AIS live (dibaca server, tidak pernah dikirim ke browser)
# Dapatkan di: https://aisstream.io
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Redis/KV cache + rate limit store.
# Supports Upstash Redis REST or Vercel KV-compatible REST variables.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Login halaman depan (diperiksa di server; isi di .env.local dan di Vercel)
LOGIN_USERNAME=
LOGIN_PASSWORD=
# Kunci tanda tangan cookie sesi login, minimal 32 karakter acak, misalnya hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Telegram (nama sesuai laporan audit B.8; nama lama TELEGRAM_CHAT_ID masih dibaca)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
